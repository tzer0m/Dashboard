@page
@model IndexModel
@using Dashboard.Models
@{
    ViewData["Title"] = "Dashboard";
    Dictionary<string, List<ServiceEntry>> singleService = Model.ServicesByDevice.Where(d => d.Value.Count == 1).OrderBy(d => d.Key).ToDictionary(d => d.Key, d => d.Value.OrderBy(s => s.Name).ToList());
    Dictionary<string, List<ServiceEntry>> multiService = Model.ServicesByDevice.Where(d => d.Value.Count > 1).OrderBy(d => d.Key).ToDictionary(d => d.Key, d => d.Value.OrderBy(s => s.Name).ToList());
}

<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
    <div class="d-flex align-items-center gap-2">
        <div id="overall-status-card" class="card @Model.OverallStatusClass text-white px-2">
            <span id="overall-status-text" class="fw-medium small">@Model.OverallStatusText</span>
        </div>
        <div class="card bg-success text-white px-2">
            <span id="online-count" class="fw-medium small">@Model.OnlineCount</span>
        </div>
        <div class="card bg-danger text-white px-2">
            <span id="offline-count" class="fw-medium small">@Model.OfflineCount</span>
        </div>
        <div class="card bg-secondary text-white px-2">
            <span id="pending-count" class="fw-medium small">@Model.PendingCount</span>
        </div>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span id="local-clock" class="text-secondary small"></span>
        <span id="utc-clock" class="text-secondary small"></span>
        <a href="@Model.DiagramUrl" target="_blank" rel="noopener noreferrer" class="card text-decoration-none text-reset d-inline-flex flex-row align-items-center gap-2 px-2 py-1 ms-2" style="cursor: pointer;">
            <img src="/Favicon?url=https://app.diagrams.net/" width="16" height="16" onerror="this.style.display='none'" />
            <span class="small fw-medium">Network Diagram</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4 mt-2">
    @foreach (KeyValuePair<string, List<ServiceEntry>> device in singleService)
    {
        <div class="service-col">
            <div class="mb-1">
                <span class="fw-medium">@device.Value.First().Device</span>
                <span class="text-secondary small ms-2">@device.Value.First().LocalIp</span>
            </div>
            @await Html.PartialAsync("_ServiceCard", new ServiceCard
            {
                Service = device.Value.First(),
                Status = Model.Statuses.GetValueOrDefault(device.Value.First().Name),
                FaviconUrl = device.Value.First().FaviconUrl,
                Uptime = Model.UptimeSummaries.GetValueOrDefault(device.Value.First().Name)
            })
        </div>
    }
</div>

@foreach (KeyValuePair<string, List<ServiceEntry>> device in multiService)
{
    <div class="mb-3 mt-3">
        <div class="mb-1">
            <span class="fw-medium">@device.Value.First().Device</span>
            <span class="text-secondary small ms-2">@device.Value.First().LocalIp</span>
        </div>
        <div class="row g-3">
            @foreach (ServiceEntry service in device.Value)
            {
                <div class="service-col">
                    @await Html.PartialAsync("_ServiceCard", new ServiceCard
                    {
                        Service = service,
                        Status = Model.Statuses.GetValueOrDefault(service.Name),
                        FaviconUrl = service.FaviconUrl,
                        Uptime = Model.UptimeSummaries.GetValueOrDefault(service.Name)
                    })
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/dashboard.js"></script>
}