@page
@model IndexModel
@using Dashboard.Models
@{
    ViewData["Title"] = "Dashboard";
    List<HostEntry> orderedHosts = [.. Model.Hosts.OrderBy(h => h.Host)];
}

<header class="dash-bar">
    <div class="dash-bar-status">
        <div id="overall-status-card" class="card @Model.OverallStatusClass text-white px-2 flex-shrink-0">
            <span id="overall-status-text" class="fw-medium small text-nowrap">@Model.OverallStatusText</span>
        </div>
        <div id="online-count-card" class="card bg-success text-white px-2 flex-shrink-0" style="@(Model.OnlineCount > 0 ? "" : "display: none;")">
            <span id="online-count" class="fw-medium small text-nowrap">@Model.OnlineCount</span>
        </div>
        <div id="offline-count-card" class="card bg-danger text-white px-2 flex-shrink-0" style="@(Model.OfflineCount > 0 ? "" : "display: none;")">
            <span id="offline-count" class="fw-medium small text-nowrap">@Model.OfflineCount</span>
        </div>
        <div id="pending-count-card" class="card bg-secondary text-white px-2 flex-shrink-0" style="@(Model.PendingCount > 0 ? "" : "display: none;")">
            <span id="pending-count" class="fw-medium small text-nowrap">@Model.PendingCount</span>
        </div>
    </div>
    <div class="dash-bar-meta">
        <span id="last-updated" class="text-secondary small text-nowrap">@(Model.LastUpdated != null ? $"{Model.LastUpdated.Value:HH:mm:ss} UTC" : "—")</span>
        <button type="button" id="global-refresh-btn" class="refresh-btn flex-shrink-0" title="Refresh All" onclick="refreshAll();">
            <svg class="refresh-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
            </svg>
        </button>
        <span class="dash-bar-divider"></span>
        <span id="utc-clock" class="text-secondary small text-nowrap"></span>
        <span id="local-clock" class="text-secondary small text-nowrap"></span>
    </div>
    <a href="/edit" title="Edit" class="dash-bar-link card text-decoration-none text-reset d-inline-flex flex-row flex-shrink-0 align-items-center gap-2 px-2 py-1">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
        <span class="dash-bar-label small fw-medium text-nowrap">Edit</span>
    </a>
</header>

<div class="host-flow-wrap">
<svg id="host-outlines" class="host-outlines" aria-hidden="true"></svg>
<div id="host-flow" class="host-flow">
    @foreach (HostEntry host in orderedHosts)
    {
        List<string> hostMonitors = [.. host.Services.SelectMany(s => s.MonitorNames)];
        int hostOnline = hostMonitors.Count(m => Model.Statuses.GetValueOrDefault(m)?.IsOnline == true);
        int hostOffline = hostMonitors.Count(m => Model.Statuses.GetValueOrDefault(m)?.IsOnline == false);
        int hostPending = hostMonitors.Count - hostOnline - hostOffline;
        <div class="flow-cell" data-host="@host.Host">
            <div class="host-head">
                <span class="host-name">@host.Host</span>
                <span class="host-ip">@host.Ip</span>
                <div class="host-pills">
                    <span class="host-pill bg-success" data-pill="online" style="@(hostOnline > 0 ? "" : "display: none;")">@hostOnline</span>
                    <span class="host-pill bg-danger" data-pill="offline" style="@(hostOffline > 0 ? "" : "display: none;")">@hostOffline</span>
                    <span class="host-pill bg-secondary" data-pill="pending" style="@(hostPending > 0 ? "" : "display: none;")">@hostPending</span>
                </div>
            </div>
        </div>
        @foreach (ServiceEntry service in host.Services.OrderBy(s => s.Name))
        {
            <div class="flow-cell" data-host="@host.Host">
                @await Html.PartialAsync("_ServiceCard", new ServiceCard
                {
                    Service = service,
                    Statuses = Model.Statuses,
                    FaviconUrl = service.FaviconUrl
                })
            </div>
        }
    }
</div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
}