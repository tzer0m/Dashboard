@model Dashboard.Models.ServiceCard
@using Dashboard.Models
@{
    List<string> monitors = Model.Service.MonitorNames;
    bool hasExtras = monitors.Count > 1;
    string displayUrl = Model.Service.Url.Replace("https://", "").Replace("http://", "");
    string faviconSrc = Model.FaviconUrl ?? $"/Favicon?url={Uri.EscapeDataString(Model.Service.Url)}";
    bool isGlobal = Model.Service.Access == "Global";
    string BadgeClass(ServiceStatus? status) => status == null ? "bg-secondary" : status.IsOnline ? "bg-success" : "bg-danger";
    string BadgeText(ServiceStatus? status) => status == null ? "–" : status.IsOnline ? "✓" : "✕";
    string BadgeTitle(string monitor, ServiceStatus? status) => hasExtras ? (status?.Error != null ? $"{monitor}: {status.Error}" : monitor) : status?.Error ?? string.Empty;
    string TimeClass(ServiceStatus? status) => status == null || !status.IsOnline ? string.Empty : status.ResponseTimeMs <= 200 ? "response-time-fast" : status.ResponseTimeMs <= 500 ? "response-time-moderate" : "response-time-slow";
    string TimeText(ServiceStatus? status) => status != null && status.IsOnline ? $"{status.ResponseTimeMs} ms" : "—";
}

<a href="@Model.Service.Url" target="_blank" rel="noopener noreferrer" class="service-card card text-decoration-none text-reset d-block h-100" data-service-name="@Model.Service.Name">
    <div class="card-body service-body">
        <div class="d-flex align-items-center gap-1">
            <img src="@faviconSrc" width="16" height="16" onerror="this.style.display='none'" />
            <h6 class="card-title mb-0 text-truncate" title="@Model.Service.Name">@Model.Service.Name</h6>
            <span class="service-badges ms-auto">
                @foreach (string monitor in monitors)
                {
                    ServiceStatus? status = Model.Statuses.GetValueOrDefault(monitor);
                    <span class="badge @BadgeClass(status)" data-monitor="@monitor" title="@BadgeTitle(monitor, status)">@BadgeText(status)</span>
                }
            </span>
        </div>
        <div class="service-sub d-flex justify-content-between align-items-center">
            <span class="service-type text-secondary text-truncate min-w-0">@Model.Service.Type</span>
            @if (!string.IsNullOrEmpty(Model.Service.RepoName))
            {
                string repoUrl = $"https://github.com/{Model.Service.RepoName}";
                <span class="repo-badge flex-shrink-0 ms-2" data-repo="@Model.Service.RepoName" title="Deploy Status" onclick="event.stopPropagation(); event.preventDefault(); window.open('@repoUrl', '_blank', 'noopener,noreferrer');">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
                    <span class="repo-badge-text">–</span>
                </span>
            }
        </div>
        <div class="service-meta d-flex align-items-center text-secondary" title="@(Model.Service.Port != null ? $"{displayUrl} (Port {Model.Service.Port})" : displayUrl)">
            <span class="d-inline-flex align-items-center gap-1 min-w-0 me-auto">
                <span class="d-inline-flex flex-shrink-0" title="@Model.Service.Access">
                    @if (isGlobal)
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                    }
                    else
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"></path>
                        </svg>
                    }
                </span>
                <span class="text-truncate">@displayUrl</span>
            </span>
            <span class="service-times ms-2">
                @foreach (string monitor in monitors)
                {
                    ServiceStatus? status = Model.Statuses.GetValueOrDefault(monitor);
                    <span class="response-time @TimeClass(status)" data-monitor-time="@monitor" title="@(hasExtras ? monitor : null)">@TimeText(status)</span>
                }
            </span>
        </div>
    </div>
</a>