{
  "manifest_version": 3,
  "name": "Tzer Dashboard New Tab",
  "version": "1.0.0",
  "description": "Shows the homelab dashboard's service links and status in every new tab.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "host_permissions": [ "https://tzer0m.co.uk/*" ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
